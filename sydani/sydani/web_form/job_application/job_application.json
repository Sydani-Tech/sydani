 "button_label": "Submit Application",
 "client_script": "function setVal(field, value) {\n    frappe.web_form.set_value(field, value);\n}\n\nfunction getVal(field) {\n    let val = frappe.web_form.get_value(field);\n    return val;\n}\n\nfrappe.web_form.on('firstname', (field, value) => {\n    let applicantName = value +' '+ getVal('lastname');\n    setVal('applicant_name', applicantName);\n    \n    if(getVal('job_title') == 'sydani-fellowship-program') {\n        setVal('sfp_batch', 'January 2026');\n    }\n});\n\nfrappe.web_form.on('lastname', (field, value) => {\n    let applicantName = getVal('firstname') +' '+ value;\n    setVal('applicant_name', applicantName);\n});\n\nfrappe.web_form.on('email_id', (field, value) => {\n    setVal('email', value);\n    setVal('username_2',value);\n});\n\nfrappe.web_form.on('mobile_number', (field, value) => {\n    setVal('phone_number', value);\n});\n\nfrappe.web_form.after_load = () => {\n    frappe.msgprint('Please note that you are only allowed to apply for one job opening, multiple applications may result in disqualification.');\n}\n\n",
